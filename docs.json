{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Hacken Extractor",
  "openapi": "openapi.json",
  "theme": "mint",
  "colors": {
    "primary": "#4f46e5",
    "light": "#818cf8",
    "dark": "#312e81"
  },
  "favicon": "/assets/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "index",
              "supported-networks",
              "monitoring-and-detection",
              "common-configurations"
            ]
          },
          {
            "group": "Security Monitoring",
            "icon": "shield",
            "pages": [
              "security-monitoring/intro",
              {
                "group": "Detectors",
                "pages": [
                  "security-monitoring/detectors/index",
                  "security-monitoring/detectors/aml-detector",
                  "security-monitoring/detectors/address-poison",
                  "security-monitoring/detectors/block-anomaly",
                  "security-monitoring/detectors/tracker"
                ]
              }
            ]
          },
          {
            "group": "Advanced Monitoring",
            "icon": "sliders",
            "pages": [
              "advanced-monitoring/intro",
              {
                "group": "Triggers",
                "pages": [
                  "advanced-monitoring/triggers/erc20-transfer",
                  "advanced-monitoring/triggers/blacklisted-callers",
                  "advanced-monitoring/triggers/function-call"
                ]
              }
            ]
          },
          {
            "group": "Legal",
            "icon": "file-contract",
            "pages": [
              "legal-documents/cookie-policy",
              "legal-documents/terms-of-service",
              "legal-documents/privacy-notice"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Projects",
            "openapi": "openapi.json",
            "pages": [
              "POST /api/v1/project",
              "GET /api/v1/project/{id}"
            ]
          },
          {
            "group": "Contracts",
            "openapi": "openapi.json",
            "pages": [
              "POST /api/v1/contract",
              "GET /api/v1/contract/{id}"
            ]
          },
          {
            "group": "Alerts",
            "openapi": "openapi.json",
            "pages": [
              "POST /api/v1/detector/alert/search",
              "POST /api/v1/detector/alert/aggregation"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Support",
          "icon": "envelope",
          "href": "/support/support"
        },
        {
          "anchor": "Open App",
          "icon": "arrow-up-right-from-square",
          "href": "https://extractor.hacken.dev"
        }
      ]
    }
  }
}
